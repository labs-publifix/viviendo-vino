# Variables de entorno de Viviendo Vino.
# Los valores reales van en Vercel (Settings → Environment Variables), nunca en el repo.
# Para desarrollo local, copia este archivo a .env.local.

# Apertura de la tienda (ISO 8601 con zona). La ventana del regalo = esta fecha + 48 horas.
NEXT_PUBLIC_LAUNCH_AT=2026-11-19T09:00:00-06:00

# Sitio (sin diagonal final). Se usa en los correos (logo, botón, baja) y en Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.viviendovino.com

# Supabase (Project Settings → Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Marcar como Sensitive en Vercel.
SUPABASE_SECRET_KEY=

# Resend (API Keys) — solo servidor, Sensitive.
RESEND_API_KEY=
EMAIL_FROM="Viviendo Vino <hola@viviendovino.com>"

# Firma de los enlaces de baja (mínimo 32 caracteres aleatorios) — solo servidor, Sensitive.
WAITLIST_TOKEN_SECRET=

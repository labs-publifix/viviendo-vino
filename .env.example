# Variables de entorno de Viviendo Vino.
# Los valores reales van en Vercel (Settings → Environment Variables), nunca en el repo.
# Para desarrollo local, copia este archivo a .env.local.

# Apertura de la tienda (ISO 8601 con zona). La ventana del regalo = esta fecha + 48 horas.
NEXT_PUBLIC_LAUNCH_AT=2026-11-19T09:00:00-06:00

# Interruptor de la tienda (ver LAUNCH.md). Production: false hasta el lanzamiento. Preview: true.
STORE_OPEN=false
# Solo en Preview (dev.viviendovino.com): activa la contraseña, la cinta y el noindex. Se lee al compilar.
NEXT_PUBLIC_PREVIEW=
# Solo en Preview: contraseña del equipo para entrar al preview. Secret.
PREVIEW_PASSWORD=

# Sitio (sin diagonal final). Se usa en los correos (logo, botón, baja) y en Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.viviendovino.com

# Supabase (Project Settings → Data API / API Keys)
# Production usa el proyecto de producción; Preview usa el proyecto de staging. Nunca mezclar.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Marcar como Sensitive en Vercel.
SUPABASE_SECRET_KEY=

# Resend (API Keys) — solo servidor, Sensitive.
RESEND_API_KEY=
EMAIL_FROM="Viviendo Vino <hola@viviendovino.com>"

# Aviso interno de cada registro nuevo (correos separados por coma).
WAITLIST_NOTIFY_TO=labs.publifix@gmail.com,raguirre@continentalmedia.com.mx

# Secuencia de correos 2 a 6 (app/api/cron/email-sequence).
# CRON_SECRET: el mismo valor va como secreto del repo en GitHub (Settings → Secrets → Actions). Sensitive.
CRON_SECRET=
# Mientras no sea "true", la secuencia solo simula (no envía).
WAITLIST_SEQUENCE_ENABLED=false

# Firma de los enlaces de baja (mínimo 32 caracteres aleatorios) — solo servidor, Sensitive.
WAITLIST_TOKEN_SECRET=

# Wine Scan (/wine-scan, /api/wine-scan). La clave de Anthropic va solo en el servidor (Sensitive):
# una clave en Production y otra distinta en Preview, cada una en su espacio de trabajo con límite de gasto.
ANTHROPIC_API_KEY=
# Modelo (se cambia sin tocar código; por ejemplo claude-haiku-5-5 para bajar costo y latencia).
WINE_SCAN_MODEL=claude-sonnet-5-5
# Interruptor de emergencia: "false" pausa Wine Scan con un mensaje amable y no llama a la API.
WINE_SCAN_ENABLED=true
# Tope de seguridad por IP (escaneos por hora). No es un límite para el uso normal.
WINE_SCAN_MAX_PER_HOUR=30
# Sal para el hash de la IP (mínimo 32 caracteres aleatorios). Solo servidor, Sensitive. La IP nunca se guarda.
WINE_SCAN_IP_SALT=

# Quiz IA (/quiz, /api/quiz/*). Usa la misma ANTHROPIC_API_KEY (solo servidor).
# Modelo de los textos (se cambia sin tocar código; por ejemplo claude-haiku-5-5 para bajar costo y latencia).
QUIZ_MODEL=
# Interruptor de emergencia: "false" pausa el quiz con un mensaje amable y no llama a la API.
QUIZ_ENABLED=
# Tope de seguridad por IP (quizzes por hora, 20 si se deja vacío). No es un límite para el uso normal.
QUIZ_RATE_LIMIT_PER_HOUR=
